# Copy to .env (git-ignored) for docker compose.
# The SQL Server must allow SQL authentication and TCP connections from Docker.
# host.docker.internal reaches the Windows host from a container.
DB_CONNECTION_STRING=Server=host.docker.internal\MSSQLSERVER01;Database=RedStarVibeApp;User Id=redstarvibe_app;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True

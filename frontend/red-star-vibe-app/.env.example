# Copy to .env.local for local overrides (never commit .env.local).
# Only VITE_* variables are exposed to the browser. Do not put secrets here.

# Backend base URL. Leave empty to use same-origin (/api is proxied by Vite in dev and nginx in Docker).
VITE_API_BASE_URL=
VITE_APP_NAME=Red Star Vibe

# Dev-server only: where Vite proxies /api requests.
DEV_API_PROXY_TARGET=http://localhost:5057
